# Conexao com o Neon (Postgres). Copie este arquivo para .env e preencha.
# DATABASE_URL: connection string COM pooler (host contem -pooler). Usada pelo app.
# DIRECT_URL: connection string SEM pooler. Usada pelas migracoes (prisma migrate).
DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx-pooler.REGIAO.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USUARIO:SENHA@ep-xxxx.REGIAO.aws.neon.tech/neondb?sslmode=require"
