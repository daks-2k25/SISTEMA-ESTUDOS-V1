# Conexao com o Neon (Postgres). Copie este arquivo para .env e preencha.
# DATABASE_URL: connection string COM pooler (host contem -pooler). Usada pelo app.
# DIRECT_URL: connection string SEM pooler. Usada pelas migracoes (prisma migrate).
DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx-pooler.REGIAO.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USUARIO:SENHA@ep-xxxx.REGIAO.aws.neon.tech/neondb?sslmode=require"

# SESSION_SECRET: assina o cookie de login. Texto aleatorio com pelo menos 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="troque-por-um-texto-aleatorio-de-32-caracteres-ou-mais"

# ---------- Integracoes (todas opcionais) ----------

# Hora de inicio dos eventos do calendario .ics (0 a 23, fuso America/Sao_Paulo). Padrao: 19.
STUDY_START_HOUR="19"

# Token para assinar o calendario no Google Agenda (/api/calendario.ics?token=...).
# Gere igual ao SESSION_SECRET. Sem ele, o .ics so baixa com login.
CALENDAR_TOKEN=""

# GitHub: seu usuario. O token e opcional (aumenta o limite de requisicoes); use um token sem permissoes extras.
GITHUB_USERNAME=""
GITHUB_TOKEN=""

# Segredo do cron do lembrete diario. A Vercel envia "Authorization: Bearer CRON_SECRET" automaticamente.
CRON_SECRET=""

# Lembrete pelo Telegram (crie o bot no @BotFather).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Lembrete por e-mail via Resend (opcional).
RESEND_API_KEY=""
EMAIL_TO=""
